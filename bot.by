import os
import urllib.parse
import xml.etree.ElementTree as ET
import requests
from bs4 import BeautifulSoup
from google import genai
from PIL import Image, ImageDraw, ImageFont

GEMINI_KEY = os.environ.get("GEMINI_API_KEY")
TG_TOKEN = os.environ.get("TELEGRAM_TOKEN")
TG_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID")
KEYWORD = os.environ.get("TARGET_KEYWORD", "속보 특징주")

def get_news_without_api(keyword):
    encoded = urllib.parse.quote(keyword)
    url = f"https://news.google.com/rss/search?q={encoded}&hl=ko&gl=KR&ceid=KR:ko"
    res = requests.get(url)
    root = ET.fromstring(res.text)
    
    articles = []
    for item in root.findall('.//item')[:5]:
        title = item.find('title').text
        pub_date = item.find('pubDate').text
        articles.append(f"최신 보도({pub_date}): {title}")
    
    naver_url = f"https://m.search.naver.com/search.naver?where=m_news&query={encoded}&sort=1"
    page = requests.get(naver_url, headers={"User-Agent": "Mozilla/5.0"})
    soup = BeautifulSoup(page.text, 'html.parser')
    for dsc in soup.select('.api_txt_lines.dsc_txt')[:3]:
        articles.append(f"상세 내용: {dsc.get_text(strip=True)}")
        
    return "\n".join(articles)

def write_blog(keyword, news_text):
    client = genai.Client(api_key=GEMINI_KEY)
    prompt = f"""
    다음은 '{keyword}' 관련 실시간 최신 뉴스 데이터입니다. 네이버 블로그 상위노출에 유리한 해설형 포스팅을 작성하세요.
    
    [규칙]
    1. 기사 문장을 그대로 베끼지 말고(유사문서 회피), 팩트만 추출해 친근하고 전문적인 '~해요/습니다' 체로 새로 작성할 것.
    2. 모바일 가독성을 위해 2~3문장마다 줄바꿈을 넣을 것.
    3. 출력 형식:
       첫째 줄: [썸네일] 썸네일에 넣을 10자 이내 핵심 문구
       둘째 줄: [제목] 클릭을 부르는 매력적인 블로그 제목
       셋째 줄부터: 본문 내용 (도입부 - 핵심 3줄 요약 - 상세 배경 및 분석 - 내 생각과 전망 - #해시태그 5개)
       
    [뉴스 데이터]
    {news_text}
    """
    res = client.models.generate_content(model='gemini-2.5-flash', contents=prompt)
    return res.text

def make_thumbnail(text):
    img = Image.new('RGB', (800, 800), color=(20, 30, 55))
    draw = ImageDraw.Draw(img)
    draw.rectangle([40, 40, 760, 760], outline=(100, 180, 255), width=6)
    try:
        font = ImageFont.truetype("/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf", 55)
    except:
        font = ImageFont.load_default()
        
    words = text.split()
    lines, cur = [], ""
    for w in words:
        if len(cur + " " + w) <= 9: cur += (" " + w if cur else w)
        else: lines.append(cur); cur = w
    if cur: lines.append(cur)
    
    y = 400 - (len(lines) * 40)
    for line in lines:
        draw.text((100, y), line, font=font, fill=(255, 255, 255))
        y += 85
    img.save("thumb.png")

def send_telegram(title, body):
    photo_url = f"https://api.telegram.org/bot{TG_TOKEN}/sendPhoto"
    with open("thumb.png", "rb") as f:
        requests.post(photo_url, data={"chat_id": TG_CHAT_ID, "caption": f"📌 추천 제목:\n{title}"}, files={"photo": f})
    msg_url = f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage"
    requests.post(msg_url, data={"chat_id": TG_CHAT_ID, "text": body[:4000]})

if __name__ == "__main__":
    news = get_news_without_api(KEYWORD)
    if news:
        raw = write_blog(KEYWORD, news)
        thumb_txt, title_txt, body_lines = KEYWORD, "오늘의 핵심 이슈 정리", []
        for line in raw.strip().split('\n'):
            if line.startswith("[썸네일]"): thumb_txt = line.replace("[썸네일]", "").strip()
            elif line.startswith("[제목]"): title_txt = line.replace("[제목]", "").strip()
            else: body_lines.append(line)
        make_thumbnail(thumb_txt)
        send_telegram(title_txt, "\n".join(body_lines).strip())
